<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingHorizontal="6dp"
    android:paddingBottom="2dp"
    android:paddingTop="0dp">

    <Space
        android:layout_width="match_parent"
        android:layout_height="24dp" />

    <LinearLayout
        android:id="@+id/displayArea"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.2"
        android:gravity="bottom|end"
        android:orientation="vertical">

        <HorizontalScrollView
            android:id="@+id/hsvHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:scrollbars="none">

            <TextView
                android:id="@+id/tvHistory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:gravity="end|center_vertical"
                android:paddingEnd="4dp"
                android:textColor="#88FFFFFF"
                android:textSize="14sp"
                android:singleLine="true"
                android:ellipsize="none"
                android:scrollHorizontally="true" />
        </HorizontalScrollView>

        <HorizontalScrollView
            android:id="@+id/hsvDisplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:scrollbars="none">

            <TextView
                android:id="@+id/tvDisplay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:gravity="end|center_vertical"
                android:paddingEnd="4dp"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:text="0"
                android:singleLine="true"
                android:ellipsize="none"
                android:scrollHorizontally="true" />
        </HorizontalScrollView>
    </LinearLayout>

    <com.nickwoluff.wearcalculator.SwipeLayout
        android:id="@+id/buttonArea"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3.5"
        android:layout_marginLeft="-6dp"
        android:layout_marginRight="-6dp"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:clipChildren="true">

    <LinearLayout
        android:id="@+id/basicButtons"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="6dp"
        android:orientation="vertical">

        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:weightSum="4">
            <Button android:id="@+id/btnAc" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:background="@drawable/bg_btn_danger" android:text="C" android:textColor="#FFF" android:textSize="16sp" />
            <Button android:id="@+id/btnDel" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:background="@drawable/bg_btn_danger" android:text="⌫" android:textColor="#FFF" android:textSize="14sp" />
            <Button android:id="@+id/btnPercent" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:background="@drawable/bg_btn_accent" android:text="%" android:textColor="#FFF" android:textSize="14sp" />
            <Button android:id="@+id/btnDiv" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:background="@drawable/bg_btn_accent" android:text="÷" android:textColor="#FFF" android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:weightSum="4">
            <Button android:id="@+id/btn7" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:background="@drawable/bg_btn_dark" android:text="7" android:textColor="#FFF" android:textSize="18sp" />
            <Button android:id="@+id/btn8" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:background="@drawable/bg_btn_dark" android:text="8" android:textColor="#FFF" android:textSize="18sp" />
            <Button android:id="@+id/btn9" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:background="@drawable/bg_btn_dark" android:text="9" android:textColor="#FFF" android:textSize="18sp" />
            <Button android:id="@+id/btnMul" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:background="@drawable/bg_btn_accent" android:text="×" android:textColor="#FFF" android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:weightSum="4">
            <Button android:id="@+id/btn4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:background="@drawable/bg_btn_dark" android:text="4" android:textColor="#FFF" android:textSize="18sp" />
            <Button android:id="@+id/btn5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:background="@drawable/bg_btn_dark" android:text="5" android:textColor="#FFF" android:textSize="18sp" />
            <Button android:id="@+id/btn6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:background="@drawable/bg_btn_dark" android:text="6" android:textColor="#FFF" android:textSize="18sp" />
            <Button android:id="@+id/btnSub" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:background="@drawable/bg_btn_accent" android:text="-" android:textColor="#FFF" android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:weightSum="4">
            <Button android:id="@+id/btn1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:background="@drawable/bg_btn_dark" android:text="1" android:textColor="#FFF" android:textSize="18sp" />
            <Button android:id="@+id/btn2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:background="@drawable/bg_btn_dark" android:text="2" android:textColor="#FFF" android:textSize="18sp" />
            <Button android:id="@+id/btn3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:background="@drawable/bg_btn_dark" android:text="3" android:textColor="#FFF" android:textSize="18sp" />
            <Button android:id="@+id/btnAdd" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:background="@drawable/bg_btn_accent" android:text="+" android:textColor="#FFF" android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:weightSum="4">
            <Button android:id="@+id/btn0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="2" android:layout_margin="2dp" android:background="@drawable/bg_btn_dark" android:text="0" android:textColor="#FFF" android:textSize="18sp" />
            <Button android:id="@+id/btnDot" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:background="@drawable/bg_btn_dark" android:text="." android:textColor="#FFF" android:textSize="18sp" />
            <Button android:id="@+id/btnEq" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:background="@drawable/bg_btn_accent" android:text="=" android:textColor="#FFF" android:textSize="18sp" />
        </LinearLayout>
    </LinearLayout>

    <include layout="@layout/scientific_buttons" />
    <com.nickwoluff.wearcalculator.PageIndicatorView
        android:id="@+id/pageIndicator"
        android:layout_width="24dp"
        android:layout_height="4dp"
        android:layout_gravity="bottom|center_horizontal" />
</com.nickwoluff.wearcalculator.SwipeLayout>
</LinearLayout>
